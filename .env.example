# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=file:./data/vcc.db

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Observability
# Optional: when set, GET /metrics requires "Authorization: Bearer <token>".
# Strongly recommended in production.
# METRICS_TOKEN=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Shared secret between the bot process and the backend. The bot sends it as
# `Authorization: Bearer <token>` on /api/bot/* service calls; the backend
# requires it when NODE_ENV=production (open in dev/test for local testing).
BOT_SERVICE_TOKEN=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Frontend
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
# Optional: absolute path to the built frontend served by the backend
# (auto-detected relative to the backend when unset)
# FRONTEND_DIST=/app/packages/frontend/dist
